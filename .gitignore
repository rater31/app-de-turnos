# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build de Vite (netlify.toml publica out/)
/out/

# production
# Ojo: la app NO es Next.js, el build va a out/ (vite.config.ts -> build.outDir).
# Estas entradas limpian restos de la app Next.js anterior; /dist evita que un
# build viejo, que nadie produce ya, vuelva a commitarse.
/.next/
/build
/dist
next-env.d.ts

# vercel
.vercel

# typescript
*.tsbuildinfo

# cache de herramientas locales
.kombai/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local data mock
/data/db.json

# supabase CLI (lo genera `supabase link`; son refs locales del proyecto)
/supabase/.temp/
